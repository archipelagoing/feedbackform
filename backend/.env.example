# Run Alembic and the API from backend/. Export overrides in your shell.
FEEDBACKFORM_DATABASE_URL=sqlite:///./data/feedbackform.db
FEEDBACKFORM_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Set to 1 when running behind HTTPS; keep 0 for the local HTTP pilot.
FEEDBACKFORM_SECURE_COOKIES=0
